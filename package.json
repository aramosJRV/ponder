{
  "name": "ponder",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "description": "Personal daily devotional app — topic-based, discernment-oriented",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "import:bible": "node scripts/import-web-bible.mjs",
    "seed": "node scripts/seed.mjs",
    "setup": "npm run import:bible && npm run seed"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/core": "^7.6.8",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/ios": "^7.6.8",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/preferences": "^7.0.4",
    "@capacitor/share": "^7.0.4",
    "@revenuecat/purchases-capacitor": "^11.3.2",
    "@supabase/supabase-js": "^2.45.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "world-english-bible": "^1.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.8",
    "@electric-sql/pglite": "^0.5.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.3"
  }
}
