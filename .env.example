# Supabase project (Settings → API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # service role — server/scripts only, never in the app

# Seed
SEED_USER_EMAIL=you@example.com

# Client env (used from step 3 onward)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Public URL of public/privacy.html once it is hosted. Linked from the paywall.
# Apple rejects auto-renewing subscription screens with a missing or dead
# privacy link, so this must be set for any build you submit.
VITE_PRIVACY_URL=https://your-host/privacy.html

# RevenueCat PUBLIC SDK keys (RevenueCat → Project → API keys → App-specific).
# These are publishable by design — they identify the app, they don't authorise
# anything. The SECRET key is never used by the client.
# iOS key is live (RevenueCat project "Ponder", app appf7545616e3).
VITE_RC_IOS_KEY=appl_ItLdOVfcICiTxoFPvFwfwmxZApx
# Android pending the Play merchant account.
VITE_RC_ANDROID_KEY=goog_...

# Local UI work only: skip the paywall in `npm run dev`. Has no effect in a
# production build (import.meta.env.DEV is false) and no effect on the server
# gate, which reads public.subscriptions regardless.
# VITE_BILLING_BYPASS=1

# Server-side secrets are NOT set here — they live in Supabase secrets:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#
# Model routing (optional — the defaults below are what generate-entry uses):
#   ANTHROPIC_MODEL_CHALLENGE=claude-sonnet-4-6           # challenge entries + retries
#   ANTHROPIC_MODEL_AFFIRMING=claude-haiku-4-5-20251001   # ~75% of entries
#   ANTHROPIC_MODEL=...   # set to pin BOTH paths to one model, e.g. to A/B quality
#   supabase secrets set RC_WEBHOOK_SECRET=<long random string>
#   supabase secrets set RC_ENTITLEMENT_ID=pro     # optional, defaults to 'pro'
#
# RC_WEBHOOK_SECRET must match the Authorization header value configured on
# the RevenueCat webhook. Generate with: openssl rand -base64 48
