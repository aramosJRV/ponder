# Supabase project (Settings → API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # service role — server/scripts only, never in the app

# Seed
SEED_USER_EMAIL=you@example.com

# Client env (used from step 3 onward)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ANTHROPIC_API_KEY is NOT set here — it lives in Supabase secrets:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
